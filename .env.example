# MediCitas - local development configuration.
# Copy to .env before running `docker compose up`.
# Passwords are embedded in connection URLs: use letters, digits, - and _ only.

# Entry point (proxy) on the host
APP_PORT=8080

# Keycloak
KEYCLOAK_PORT=8081
# Must match KEYCLOAK_PORT: it becomes the issuer of every token.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
# Secret of the tenancy-service client (service-to-service calls).
TENANCY_CLIENT_SECRET=tenancy-service-dev-secret

# PostgreSQL superuser (only used by the init and seed jobs)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# One owner role (migrations) and one application role per service
TENANCY_DB_OWNER_PASSWORD=tenancy_owner_dev
TENANCY_DB_APP_PASSWORD=tenancy_app_dev
AGENDA_DB_OWNER_PASSWORD=agenda_owner_dev
AGENDA_DB_APP_PASSWORD=agenda_app_dev
EXPEDIENTE_DB_OWNER_PASSWORD=expediente_owner_dev
EXPEDIENTE_DB_APP_PASSWORD=expediente_app_dev
AUDIT_DB_OWNER_PASSWORD=audit_owner_dev
AUDIT_DB_APP_PASSWORD=audit_app_dev

# info or debug
LOG_LEVEL=info
