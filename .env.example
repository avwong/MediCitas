# MediCitas: configuración para desarrollo local.
# Copiar a .env antes de ejecutar `docker compose up`.
# Las contraseñas van dentro de URLs de conexión: usar solo letras, dígitos, -
# y _.

# Puerto del punto de entrada (proxy) en el host.
APP_PORT=8080

# Keycloak
KEYCLOAK_PORT=8081
# Debe coincidir con KEYCLOAK_PORT: es el emisor (issuer) de todos los tokens.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev

# Secretos de los clients de servicio, para las llamadas entre servicios.
TENANCY_CLIENT_SECRET=tenancy-service-dev-secret
AGENDA_CLIENT_SECRET=agenda-service-dev-secret
EXPEDIENTE_CLIENT_SECRET=expediente-service-dev-secret

# Superusuario de PostgreSQL. Solo lo usan la inicialización de la
# infraestructura y la carga de la semilla de desarrollo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# ---------------------------------------------------------------------------
# Perfiles de menor privilegio de PostgreSQL
#
# Cada servicio tiene:
#
#   *_owner      migraciones (DDL)
#   *_app        identidad de la aplicación
#   *_readonly   identidad de diagnóstico, solo SELECT
# ---------------------------------------------------------------------------

TENANCY_DB_OWNER_PASSWORD=tenancy_owner_dev
TENANCY_DB_APP_PASSWORD=tenancy_app_dev
TENANCY_DB_READONLY_PASSWORD=tenancy_readonly_dev

AGENDA_DB_OWNER_PASSWORD=agenda_owner_dev
AGENDA_DB_APP_PASSWORD=agenda_app_dev
AGENDA_DB_READONLY_PASSWORD=agenda_readonly_dev

EXPEDIENTE_DB_OWNER_PASSWORD=expediente_owner_dev
EXPEDIENTE_DB_APP_PASSWORD=expediente_app_dev
EXPEDIENTE_DB_READONLY_PASSWORD=expediente_readonly_dev

AUDIT_DB_OWNER_PASSWORD=audit_owner_dev
AUDIT_DB_APP_PASSWORD=audit_app_dev
AUDIT_DB_READONLY_PASSWORD=audit_readonly_dev

# info o debug
LOG_LEVEL=info
