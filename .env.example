# MediCitas - Local development configuration

# Application
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=medicitas
POSTGRES_USER=medicitas
POSTGRES_PASSWORD=medicitas_dev

# Redis
REDIS_PORT=6379

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
