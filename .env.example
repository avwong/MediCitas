# OIDC / Keycloak
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/medicitas
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/medicitas/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=medicitas-api